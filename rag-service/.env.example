# Qdrant Cloud
QDRANT_URL=https://<cluster-id>.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=history_chunks

# Google AI (Gemini — chỉ dùng cho embedding)
GOOGLE_API_KEY=your_google_ai_studio_api_key
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Local embedding fallback — "google" | "local"
LOCAL_EMBEDDING_MODEL=keepitreal/vietnamese-sbert

# Cerebras (Chat LLM chính)
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Pipeline defaults
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
SCORE_THRESHOLD=0.5
