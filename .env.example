# ============================================================
# RAG-edu — Full environment template (all services)
# Copy this file -> backend/.env & rag-service/.env
# Copy Frontend section -> apps/web/.env.local
# ============================================================

# ─── Backend ─────────────────────────────────────────────────
BACKEND_PORT=8080

# MySQL / TiDB Cloud
MYSQL_URL=jdbc:mysql://host:port/edu_rag?useSSL=true&requireSSL=true&serverTimezone=UTC
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=edu_rag
MYSQL_ROOT_PASSWORD=root_password              # Docker MySQL only

# JPA / Flyway
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-48-bytes
JWT_ACCESS_TOKEN_EXPIRATION=86400              # seconds (24h)
JWT_REFRESH_TOKEN_EXPIRATION=259200            # seconds (3 days)
REFRESH_COOKIE_SECURE=false                    # true in production

# Upload
UPLOAD_BASE_PATH=./uploads
MAX_FILE_SIZE=150MB
MAX_REQUEST_SIZE=160MB

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Document review (AI classify trước khi ingest)
DOCUMENT_REVIEW_ENABLED=true

# Soft delete
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON=0 0 2 * * *

# ─── RAG Service URL (backend -> rag-service) ───────────────
RAG_SERVICE_URL=http://localhost:8001          # or http://rag-service:8001 in Docker
RAG_SERVICE_REQUEST_TIMEOUT=60s

# ─── Qdrant Cloud ────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=history_chunks

# ─── Google AI (Gemini — chỉ dùng cho embedding) ───────────
GOOGLE_API_KEY=your_google_ai_studio_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ─── Cerebras (Chat LLM chính) ──────────────────────────────
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Google LLM fallback (nếu LLM_PROVIDER=google)
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=${GOOGLE_API_KEY}

# ─── RAG pipeline defaults ──────────────────────────────────
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
SCORE_THRESHOLD=0.5

# ─── Frontend (copy vào apps/web/.env.local) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3000/home
NEXT_PUBLIC_GOOGLE_FAILURE_REDIRECT_URL=http://localhost:3000/google/failure
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=PLACE_HOLDER    # để PLACE_HOLDER để dùng server upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=PLACE_HOLDER
