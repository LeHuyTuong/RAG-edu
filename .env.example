# ============================================================
# RAG-edu — Full environment template for all services
# Copy this file to .env and fill in your values
# ============================================================

# ─── MySQL / TiDB ───────────────────────────────────────────
MYSQL_URL=jdbc:mysql://host:port/edu_rag?useSSL=true&requireSSL=true&serverTimezone=UTC
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=edu_rag
MYSQL_ROOT_PASSWORD=root_password        # only needed for Docker MySQL

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-48-bytes
JWT_ACCESS_TOKEN_EXPIRATION=900          # seconds (15 min)
JWT_REFRESH_TOKEN_EXPIRATION=259200      # seconds (3 days)
REFRESH_COOKIE_SECURE=false              # true in production

# ─── JPA / Flyway ───────────────────────────────────────────
JPA_DDL_AUTO=update                      # or validate
FLYWAY_ENABLED=false                     # true for production migration
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false

# ─── Qdrant Cloud ──────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=history_chunks

# ─── Google AI (Gemini embedding + Gemma LLM) ──────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key
LLM_API_KEY=${GOOGLE_API_KEY}
LLM_MODEL=gemma-4-31b-it
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ─── RAG Service ────────────────────────────────────────────
RAG_SERVICE_URL=http://localhost:8001    # or http://rag-service:8001 in Docker
RAG_SERVICE_REQUEST_TIMEOUT=60s

# RAG pipeline defaults (rag-service only)
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=5
SCORE_THRESHOLD=0.5

# ─── Upload ────────────────────────────────────────────────
UPLOAD_BASE_PATH=./uploads
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB

# ─── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ─── Frontend (apps/web/.env.local) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:3000/home
NEXT_PUBLIC_GOOGLE_FAILURE_REDIRECT_URL=http://localhost:3000/google/failure
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=PLACE_HOLDER   # leave as-is for server upload
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=PLACE_HOLDER

# ─── Document Review ───────────────────────────────────────
DOCUMENT_REVIEW_ENABLED=true

# ─── Soft Delete ────────────────────────────────────────────
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON=0 0 2 * * *

# ─── Cookie / Auth ─────────────────────────────────────────
# (used by apps/api, not the main backend)
COOKIE_NAME=access_token
COOKIE_SECRET=change-me
