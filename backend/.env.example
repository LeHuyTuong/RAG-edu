BACKEND_PORT=8080

# MySQL / TiDB Cloud
MYSQL_URL=jdbc:mysql://localhost:3307/history_rag?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
MYSQL_USER=history
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=history_rag
MYSQL_ROOT_PASSWORD=change-me

# JPA / Flyway
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-48-bytes
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=259200
REFRESH_COOKIE_SECURE=false

# Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=history_chunks

# Google AI (Gemini — dùng cho embedding)
GOOGLE_API_KEY=your_google_ai_studio_api_key
LLM_API_KEY=your_google_ai_studio_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Cerebras (chat LLM chính)
LLM_PROVIDER=cerebras
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
OPENROUTER_API_KEY=your_openrouter_api_key

# Google LLM (Gemma — fallback nếu LLM_PROVIDER=google)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemma-4-31b-it

# RAG service
RAG_SERVICE_URL=http://localhost:8001
RAG_SERVICE_REQUEST_TIMEOUT=60s

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Document review
DOCUMENT_REVIEW_ENABLED=true

# Soft delete
SOFT_DELETE_RETENTION_DAYS=30
SOFT_DELETE_CRON=0 0 2 * * *

# Upload
UPLOAD_BASE_PATH=./uploads
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB

