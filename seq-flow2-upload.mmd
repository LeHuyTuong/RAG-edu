sequenceDiagram
    participant S as Student (Browser)
    participant DC as :DocumentController
    participant DS as :DocumentServiceImpl
    participant FR as :FolderRepository
    participant AR as :AppSettingRepository
    participant LFS as :LocalFileStorageService
    participant DR as :DocumentRepository
    participant DB as MySQL
    participant DIL as :DocumentIngestListener
    participant RC as :RagClientServiceImpl
    participant RS as Rag-Service :8002
    participant Q as Qdrant
    participant G as Gemini API

    %% ── SYNC ──
    S->>+DC: POST /api/v1/documents (multipart: file.pdf + {title,folderId,isPublic}) | Auth: Bearer JWT
    DC->>DC: extract userId from @AuthenticationPrincipal Jwt
    DC->>+DS: create(file, CreateDocumentRequest, userId)

    DS->>FR: findByIdAndOwnerId(folderId, userId)
    FR->>DB: SELECT * FROM folders WHERE id=? AND owner_id=?
    DB-->>FR: row
    FR-->>DS: Folder entity

    DS->>AR: findFirst()
    AR->>DB: SELECT * FROM app_settings LIMIT 1
    DB-->>AR: row
    AR-->>DS: AppSetting{ allowedTypes, maxSizeMb }

    DS->>DS: validate ext ∈ allowedTypes && size ≤ maxSizeMb

    DS->>LFS: store(file)
    LFS-->>DS: StoredFile{ filePath="./uploads/{uuid}.pdf", publicId }

    DS->>DS: new Document(title, fileUrl, publicId, UPLOADING, folderId, ownerId)
    DS->>DR: save(document)
    DR->>DB: INSERT INTO documents (title,file_url,public_id,status,folder_id,owner_id) VALUES (...)
    DB-->>DR: generated id
    DR-->>DS: Document{ id, status=UPLOADING }

    DS->>DS: publishEvent(DocumentIngestRequested{ docId })
    DS-->>-DC: DocumentResponse{ id, status:"UPLOADING" }
    DC-->>-S: 200 { id, status:"UPLOADING" }

    %% ── ASYNC: @TransactionalEventListener(AFTER_COMMIT) + @Async ──
    Note over DIL,G: [async thread — AFTER_COMMIT]

    activate DIL
    DIL->>DR: findById(docId)
    DR->>DB: SELECT * FROM documents WHERE id=?
    DB-->>DR: row
    DR-->>DIL: Document entity

    DIL->>DR: save(doc{ status=INDEXING })
    DR->>DB: UPDATE documents SET status='INDEXING' WHERE id=?
    DB-->>DR: ok
    DR-->>DIL: Document entity

    DIL->>+RC: ingest(RagIngestRequest{ sourceId=docId, filePath, metadata:{folderId,userId} })
    RC->>+RS: POST /ingest (WebClient)

    RS->>RS: extract text (pdfplumber) → pages[]
    RS->>RS: chunk text (size=800, overlap=120) → chunks[]
    RS->>G: embed_documents(chunks[].text) → vectors[768]
    G-->>RS: embeddings[]
    RS->>Q: upsert points{ sourceId, folderId, userId, pageNumber, chunkText }
    Q-->>RS: OK

    RS-->>-RC: RagIngestResponse{ status:"COMPLETED", chunks:[...] }
    RC-->>-DIL: RagIngestResponse

    DIL->>DR: save(doc{ status=READY, chunkCount=N })
    DR->>DB: UPDATE documents SET status='READY', chunk_count=N WHERE id=?
    DB-->>DR: ok
    DR-->>DIL: Document entity
    deactivate DIL
