sequenceDiagram
    participant S as Student (Browser)
    participant AC as :AuthController
    participant AS as :AuthServiceImpl
    participant UR as :UserRepository
    participant RT as :RefreshTokenRepository
    participant DB as MySQL

    S->>+AC: POST /api/v1/auth/login { email, password }
    AC->>+AS: login(LoginRequest)

    AS->>UR: findByEmail(email)
    UR->>DB: SELECT * FROM users WHERE email=?
    DB-->>UR: row
    UR-->>AS: User entity

    AS->>AS: BCrypt.matches(rawPwd, user.password)

    AS->>AS: new RefreshToken(userId, token, expiresAt)
    AS->>RT: save(refreshToken)
    RT->>DB: INSERT INTO refresh_tokens (user_id, token, expires_at) VALUES (...)
    DB-->>RT: ok
    RT-->>AS: RefreshToken entity

    AS->>AS: jwtUtil.generateAccessToken(user)
    AS-->>-AC: LoginResponse{ accessToken, refreshToken }
    AC-->>-S: 200 { accessToken, refreshToken }